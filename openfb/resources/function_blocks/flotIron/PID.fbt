<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="PID" Comment="PID regulator" >
	<VersionInfo Organization="SWDC RTSoft" Version="1.0" Author="AN">
	</VersionInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="Event">
				<With Var="INERROR"/>
			</Event>
			<Event Name="REQ" Type="Event">
				<With Var="INERROR"/>
				<With Var="NOISE"/>
				<With Var="KP"/>
				<With Var="KI"/>
				<With Var="KD"/>
				<With Var="INTERVAL"/>
				<With Var="LIM_H"/>
				<With Var="LIM_L"/>
			</Event>
			<Event Name="RST" Type="Event">
				<With Var="INERROR"/>
				<With Var="NOISE"/>
				<With Var="KP"/>
				<With Var="KI"/>
				<With Var="KD"/>
				<With Var="INTERVAL"/>
				<With Var="LIM_H"/>
				<With Var="LIM_L"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="Event">
			</Event>
			<Event Name="CNF" Type="Event">
				<With Var="Y"/>
				<With Var="LIM"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="MODE" Type="BOOL"/>
			<VarDeclaration Name="PV" Type="REAL"/>
			<VarDeclaration Name="SP" Type="REAL"/> 
			<VarDeclaration Name="MAN_OUT" Type="REAL"/>
			<VarDeclaration Name="KP" Type="REAL"/>
			<VarDeclaration Name="KI" Type="REAL"/>
			<VarDeclaration Name="KD" Type="REAL"/>
			<VarDeclaration Name="INTERVAL" Type="REAL"/>
			<VarDeclaration Name="LIM_H" Type="REAL"/>
			<VarDeclaration Name="LIM_L" Type="REAL"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="Y" Type="REAL" /> 
			<VarDeclaration Name="LIM" Type="REAL"/>
		</OutputVars>
	</InterfaceList>
</FBType>
