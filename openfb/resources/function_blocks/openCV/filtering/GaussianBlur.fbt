<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="GaussianBlur" Comment="openCV gaussian blur filter" >
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event">
				<With Var="IMG_ID"/>
				<With Var="QUEUE_ID"/>
				<With Var="KSIZE"/>
				<With Var="SIGMAX"/>
				<With Var="SIGMAY"/>
				<With Var="BORDER_TYPE"/>
				<With Var="HINT"/>   <!-- morphologyDefaultBorderValue -->
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event">
				<With Var="IMG_IDO"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="IMG_ID" Type="UDINT"/>
			<VarDeclaration Name="QUEUE_ID" Type="STRING"/>
			<VarDeclaration Name="KSIZE" Type="INT" ArraySize="2"/>
			<VarDeclaration Name="SIGMAX" Type="REAL"/>
			<VarDeclaration Name="SIGMAY" Type="REAL"/>
			<VarDeclaration Name="BORDER_TYPE" Type="INT"/>
			<VarDeclaration Name="HINT" Type="INT"/>			 <!--!!!!!!!!!!!!!!!!!!!!!!!!!!!-->
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="IMG_IDO" Type="UDINT"/>
		</OutputVars>
	</InterfaceList>
</FBType>

