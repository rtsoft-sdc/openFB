<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="Blur" Comment="openCV blur filter" >
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event">
				<With Var="IMG_ID"/>
				<With Var="QUEUE_ID"/>
				<With Var="KSIZE"/>
				<With Var="ANCHOR"/>
				<With Var="BORDER_TYPE"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event">
				<With Var="IMG_IDO"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="IMG_ID" Type="UDINT"/>
			<VarDeclaration Name="QUEUE_ID" Type="STRING"/>
			<VarDeclaration Name="KSIZE" Type="INT" ArraySize="2"/>
			<VarDeclaration Name="ANCHOR" Type="INT" ArraySize="2"/>
			<VarDeclaration Name="BORDER_TYPE" Type="INT"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="IMG_IDO" Type="UDINT"/>
		</OutputVars>
	</InterfaceList>
</FBType>

