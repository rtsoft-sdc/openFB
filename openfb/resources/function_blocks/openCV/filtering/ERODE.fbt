<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="ERODE" Comment="openCV erode filter" >
	<VersionInfo Organization="SWDC RTSoft" Version="1.0" Author="AN">
	</VersionInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event">
				<With Var="QUEUE_ID"/>
				<With Var="IMG_ID"/>
				<With Var="KERNEL"/>
				<With Var="ITERATIONS"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event">
				<With Var="STATUS"/>
				<With Var="IMG_IDO"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QUEUE_ID" Type="STRING"/>
			<VarDeclaration Name="IMG_ID" Type="UDINT"/>
			<VarDeclaration Name="KERNELSIZE" Type="INT" Comment="Size of the erosion kernel. Must be a positive odd integer"/>
			<VarDeclaration Name="KERNEL" Type="INT" ArraySize="1024" Comment="Erosion kernel. Array of integers will be reshaped into a square matrix"/>
			<VarDeclaration Name="ITERATIONS" Type="INT"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="STATUS" Type="STRING"/>
			<VarDeclaration Name="IMG_IDO" Type="UDINT"/>
		</OutputVars>
	</InterfaceList>
	<SimpleFB><Algorithm Name="REQ"><ST>
	</ST></Algorithm></SimpleFB>
</FBType>

