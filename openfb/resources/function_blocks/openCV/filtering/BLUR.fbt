<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="BLUR" Comment="openCV blur filter" >
	<VersionInfo Organization="SWDC RTSoft" Version="1.0" Author="AN">
	</VersionInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event">
				<With Var="QUEUE_ID"/>
				<With Var="IMG_ID"/>
				<With Var="KSIZE"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event">
				<With Var="STATUS"/>
				<With Var="IMG_IDO"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QUEUE_ID" Type="STRING"/>
			<VarDeclaration Name="IMG_ID" Type="UDINT"/>
			<VarDeclaration Name="KSIZE" Type="INT" ArraySize="2" Comment="blurring kernel size [width, height]"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="STATUS" Type="STRING"/>
			<VarDeclaration Name="IMG_IDO" Type="UDINT"/>
		</OutputVars>
	</InterfaceList>
	<SimpleFB><Algorithm Name="REQ"><ST>
	</ST></Algorithm></SimpleFB>
</FBType>

