<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="MorphologyEx" Comment="openCV morphology ex filter" >
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event">
				<With Var="IMG_ID"/>
				<With Var="QUEUE_ID"/>
				<With Var="MORPH_OP"/>
				<With Var="KERNEL"/>
				<With Var="ANCHOR"/>
				<With Var="ITERATIONS"/>
				<With Var="BORDER_TYPE"/>   
				<With Var="BORDERVALUE"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event">
				<With Var="IMG_IDO"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="IMG_ID" Type="UDINT"/>
			<VarDeclaration Name="QUEUE_ID" Type="STRING"/>
			<VarDeclaration Name="MORPH_OP" Type="INT"/>
			<VarDeclaration Name="KERNEL" Type="INT" ArraySize="2"/>
			<VarDeclaration Name="ANCHOR" Type="INT" ArraySize="2"/>
			<VarDeclaration Name="ITERATIONS" Type="INT"/>
			<VarDeclaration Name="BORDER_TYPE" Type="INT"/>
			<VarDeclaration Name="BORDERVALUE" Type="REAL"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="IMG_IDO" Type="UDINT"/>
		</OutputVars>
	</InterfaceList>
</FBType>

