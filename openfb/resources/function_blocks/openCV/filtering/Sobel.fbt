<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="Sobel" Comment="openCV sobel filter" >
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event">
				<With Var="IMG_ID"/>
				<With Var="QUEUE_ID"/>
				<With Var="DDEPTH"/>
				<With Var="DX"/>
				<With Var="DY"/>
				<With Var="KSIZE"/>
				<With Var="SCALE"/>
				<With Var="DELTA"/>
				<With Var="BORDER_TYPE"/>   <!-- morphologyDefaultBorderValue -->
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event">
				<With Var="IMG_IDO"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="IMG_ID" Type="UDINT"/>
			<VarDeclaration Name="QUEUE_ID" Type="STRING"/>
			<VarDeclaration Name="DDEPTH" Type="INT"/>
			<VarDeclaration Name="DX" Type="INT"/>
			<VarDeclaration Name="DY" Type="INT"/>
			<VarDeclaration Name="KSIZE" Type="INT"/>
			<VarDeclaration Name="SCALE" Type="DOUBLE"/>
			<VarDeclaration Name="DELTA" Type="DOUBLE"/>	
			<VarDeclaration Name="BORDER_TYPE" Type="INT"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="IMG_IDO" Type="UDINT"/>
		</OutputVars>
	</InterfaceList>
</FBType>

