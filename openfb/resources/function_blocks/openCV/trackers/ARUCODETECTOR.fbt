<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="ARUCODETECTOR" Comment="openCV Aruco Detector" >
	<VersionInfo Organization="SWDC RTSoft" Version="1.0" Author="AN">
	</VersionInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event">
				<With Var="QUEUE_ID"/>
				<With Var="IMG_ID"/>
				<With Var="DICTIONARY"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event">
				<With Var="STATUS"/>
				<With Var="IMG_IDO"/>
				<With Var="CORNERS"/>
				<With Var="IDS"/>
				<With Var="REJECTED"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QUEUE_ID" Type="STRING"/>
			<VarDeclaration Name="IMG_ID" Type="UDINT"/>
			<VarDeclaration Name="DICTIONARY" Type="STRING"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="STATUS" Type="STRING"/>
			<VarDeclaration Name="IMG_IDO" Type="UDINT"/>
			<VarDeclaration Name="CORNERS" Type="INT" ArraySize="1024" Comment="Detected Aruco marker corners"/>
			<VarDeclaration Name="IDS" Type="INT" ArraySize="1024" Comment="Detected Aruco marker IDs"/>
			<VarDeclaration Name="REJECTED" Type="INT" ArraySize="1024" Comment="Rejected Aruco marker candidates"/>
		</OutputVars>
	</InterfaceList>
	<SimpleFB><Algorithm Name="REQ"><ST>
	</ST></Algorithm></SimpleFB>
</FBType>
