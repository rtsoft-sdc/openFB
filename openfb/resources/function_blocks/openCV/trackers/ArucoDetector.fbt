<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="ArucoDetector" Comment="openCV Aruco Detector" >
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event">
				<With Var="IMG_ID"/>
				<With Var="QUEUE_ID"/>
				<With Var="DICTIONARY"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event">
				<With Var="IMG_ID"/>
				<With Var="CORNERS"/>
				<With Var="IDS"/>
				<With Var="REJECTED"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="IMG_ID" Type="UDINT"/>
			<VarDeclaration Name="QUEUE_ID" Type="STRING"/>
			<VarDeclaration Name="DICTIONARY" Type="STRING"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="IMG_ID" Type="UDINT"/>
			<VarDeclaration Name="CORNERS" Type="INT" ArraySize="*"/>
			<VarDeclaration Name="IDS" Type="INT" ArraySize="*"/>
			<VarDeclaration Name="REJECTED" Type="INT" ArraySize="*"/>
		</OutputVars>
	</InterfaceList>
</FBType>
