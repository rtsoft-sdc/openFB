<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="WARPAFFINE" Comment="openCV warp affine" >
	<VersionInfo Organization="SWDC RTSoft" Version="1.0" Author="AN">
	</VersionInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event">
				<With Var="QUEUE_ID"/>
				<With Var="IMG_ID"/>
				<With Var="TRANSFORMATION_MATRIX"/>
				<With Var="DSIZE"/>				
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event">
				<With Var="STATUS"/>
				<With Var="IMG_IDO"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QUEUE_ID" Type="STRING"/>
			<VarDeclaration Name="IMG_ID" Type="UDINT"/>
			<VarDeclaration Name="TRANSFORMATION_MATRIX" Type="INT" ArraySize="2*3" Comment="Transformation matrix- Array will be transformed in 2x3 matrix"/>
			<VarDeclaration Name="DSIZE" Type="INT" ArraySize="2" Comment="Destination size"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="STATUS" Type="STRING"/>
			<VarDeclaration Name="IMG_IDO" Type="UDINT"/>
		</OutputVars>
	</InterfaceList>
	<SimpleFB><Algorithm Name="REQ"><ST>
	</ST></Algorithm></SimpleFB>
</FBType>
