<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="ADAPTIVETHRESHOLD" Comment="openCV adaptive threshold" >
	<VersionInfo Organization="SWDC RTSoft" Version="1.0" Author="AN">
	</VersionInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event">
				<With Var="QUEUE_ID"/>
				<With Var="IMG_ID"/>
				<With Var="MAXVAL"/>
				<With Var="ADAPTIVE_METHOD"/>
				<With Var="THRESHOLD_TYPE"/>
				<With Var="BLOCK_SIZE"/>
				<With Var="C"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event">
				<With Var="STATUS"/>
				<With Var="IMG_IDO"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QUEUE_ID" Type="STRING"/>
			<VarDeclaration Name="IMG_ID" Type="UDINT"/>
			<VarDeclaration Name="MAXVAL" Type="REAL"/>
			<VarDeclaration Name="ADAPTIVE_METHOD" Type="INT" Comment="0: ADAPTIVE_THRESH_MEAN_C, 1: ADAPTIVE_THRESH_GAUSSIAN_C"/>
			<VarDeclaration Name="THRESHOLD_TYPE" Type="INT" Comment="0: BINARY_INV, 1: BINARY, 2: TOZERO_INV, 3: TOZERO, 4: TRUNC"/>
			<VarDeclaration Name="BLOCK_SIZE" Type="UDINT"/>
			<VarDeclaration Name="C" Type="REAL" Comment="Free parameter for the threshold"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="STATUS" Type="STRING"/>
			<VarDeclaration Name="IMG_IDO" Type="UDINT"/>
		</OutputVars>
	</InterfaceList>
	<SimpleFB><Algorithm Name="REQ"><ST>
	</ST></Algorithm></SimpleFB>
</FBType>
