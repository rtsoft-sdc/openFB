<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="WarpPolar" Comment="openCV warp polar" >
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event">
				<With Var="IMG_ID"/>
				<With Var="QUEUE_ID"/>
				<With Var="DSIZE"/>
				<With Var="CENTER"/>
				<With Var="MAXRADIUS"/>
				<With Var="FLAGS"/>
				
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event">
				<With Var="IMG_IDO"/>
				<With Var="QUEUE_IDO"/>
				<With Var="STATUS"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="IMG_ID" Type="UDINT"/>
			<VarDeclaration Name="QUEUE_ID" Type="STRING"/>
			<VarDeclaration Name="DSIZE" Type="INT" ArraySize="2"/>
			<VarDeclaration Name="CENTER" Type="REAL" ArraySize="2"/>
			<VarDeclaration Name="MAXRADIUS" Type="REAL"/>
			<VarDeclaration Name="FLAGS" Type="STRING"/>

		</InputVars>
		<OutputVars>
			<VarDeclaration Name="IMG_IDO" Type="UDINT"/>
			<VarDeclaration Name="QUEUE_IDO" Type="STRING"/>
			<VarDeclaration Name="STATUS" Type="STRING"/>
		</OutputVars>
	</InterfaceList>
</FBType>

