<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="Adaptive_Threshold" Comment="openCV adaptive threshold" >
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event">
				<With Var="IMG_ID"/>
				<With Var="QUEUE_ID"/>
				<With Var="MAXVAL"/>
				<With Var="ADAPTIVE_METHOD"/>
				<With Var="THRESHOLD_TYPE"/>
				<With Var="BLOCK_SIZE"/>
				<With Var="C"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event">
				<With Var="IMG_IDO"/>
				<With Var="QUEUE_IDO"/>
				<With Var="STATUS"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL"/>
			<VarDeclaration Name="IMG_ID" Type="UDINT"/>
			<VarDeclaration Name="QUEUE_ID" Type="STRING"/>
			<VarDeclaration Name="MAXVAL" Type="REAL"/>
			<VarDeclaration Name="ADAPTIVE_METHOD" Type="STRING"/>
			<VarDeclaration Name="THRESHOLD_TYPE" Type="STRING"/>
			<VarDeclaration Name="BLOCK_SIZE" Type="UDINT"/>
			<VarDeclaration Name="C" Type="REAL"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="IMG_IDO" Type="UDINT"/>
			<VarDeclaration Name="QUEUE_IDO" Type="STRING"/>
			<VarDeclaration Name="STATUS" Type="STRING"/>
		</OutputVars>
	</InterfaceList>
</FBType>
