<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="Resize" Comment="openCV resize" >
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event">
				<With Var="IMG_ID"/>
				<With Var="QUEUE_ID"/>
				<With Var="WIDTH"/>
				<With Var="HEIGHT"/>
				<With Var="INTERPOLATION"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event">
				<With Var="IMG_IDO"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL"/>
			<VarDeclaration Name="IMG_ID" Type="UDINT"/>
			<VarDeclaration Name="QUEUE_ID" Type="STRING"/>
			<VarDeclaration Name="WIDTH" Type="UDINT"/>
			<VarDeclaration Name="HEIGHT" Type="UDINT"/>
			<VarDeclaration Name="INTERPOLATION" Type="UDINT"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="IMG_IDO" Type="UDINT"/>
		</OutputVars>
	</InterfaceList>
</FBType>
