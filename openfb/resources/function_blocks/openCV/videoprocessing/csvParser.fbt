<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="csvParser" Comment="filenames output" >
	<VersionInfo Organization="SWDC RTSoft" Version="1.0" Author="AN">
	</VersionInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event">
				<With Var="FILENAME"/>
				<With Var="FILEORDER"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event">
				<With Var="STATUS"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="FILENAME" Type="STRING"/>
			<VarDeclaration Name="FILEORDER" Type="INT"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="FILENAMES" Type="STRING"/>
		</OutputVars>
	</InterfaceList>
</FBType>
