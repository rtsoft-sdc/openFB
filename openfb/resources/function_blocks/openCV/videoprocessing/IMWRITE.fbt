<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="IMWRITE" Comment="openCV write image" >
	<VersionInfo Organization="SWDC RTSoft" Version="1.0" Author="Alex">
	</VersionInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event">
				<With Var="QI"/>
				<With Var="QUEUE_ID"/>
				<With Var="IMG_ID"/>
				<With Var="FILENAME"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event">
				<With Var="QO"/>
				<With Var="STATUS"/>
				<With Var="IMG_IDO"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL"/>
			<VarDeclaration Name="QUEUE_ID" Type="STRING"/>
			<VarDeclaration Name="IMG_ID" Type="UDINT"/>
			<VarDeclaration Name="FILENAME" Type="STRING"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="STRING"/>
			<VarDeclaration Name="STATUS" Type="STRING"/>
			<VarDeclaration Name="IMG_IDO" Type="UDINT"/>
		</OutputVars>
	</InterfaceList>
	<Service RightInterface="RESOURCE" LeftInterface="APPLICATION" Comment="Service Interface Function Block Type">
	</Service>
</FBType>
