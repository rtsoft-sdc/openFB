<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<FBType Name="Imread" Comment="Imread OpenCV function block">
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event" Comment="">
				<With Var="FILE_PATH"/>
				<With Var="QUEUE_ID"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event" Comment="">
				<With Var="IMG_IDO"/>
				<With Var="QUEUE_IDO"/>
				<With Var="STATUSO"/>				
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="FILE_PATH" Type="STRING" Comment=""/>
			<VarDeclaration Name="QUEUE_ID" Type="STRING" Comment=""/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="IMG_IDO" Type="UDINT"/>
			<VarDeclaration Name="QUEUE_IDO" Type="STRING"/>
			<VarDeclaration Name="STATUSO" Type="STRING"/>
		</OutputVars>
	</InterfaceList>
</FBType>
