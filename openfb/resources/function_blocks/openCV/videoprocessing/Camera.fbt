<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<FBType Name="CAMERA" Comment="Camera OpenCV function block">
	<VersionInfo Organization="SWDC RTSoft" Version="1.0" Author="AN">
	</VersionInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="Event">
				<With Var="DEVICE_ID"/>
				<With Var="QUEUE_ID"/>
				<With Var="FPS"/>
			</Event>
			<Event Name="REQ" Type="Event">
				<With Var="QI"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="Event">
				<With Var="QO"/>
				<With Var="STATUS"/>
			</Event>
			<Event Name="CNF" Type="Event">
				<With Var="QO"/>
				<With Var="IMG_ID"/>
				<With Var="STATUSO"/>				
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL" Comment=""/>
			<VarDeclaration Name="ID" Type="STRING" Comment=""/>
			<VarDeclaration Name="PARAM" Type="STRING" Comment=""/>
			<VarDeclaration Name="QUEUE_ID" Type="STRING" Comment=""/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment=""/>
			<VarDeclaration Name="IMG_ID" Type="UDINT"/>
			<VarDeclaration Name="QUEUE_IDO" Type="STRING"/>
			<VarDeclaration Name="STATUS" Type="STRING"/>
		</OutputVars>
	</InterfaceList>
	<Service RightInterface="RESOURCE" LeftInterface="APPLICATION" Comment="Service Interface Function Block Type">
	</Service>
</FBType>
