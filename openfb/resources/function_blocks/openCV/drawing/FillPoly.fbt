<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="FillPoly" Comment="openCV fillPolygon" >
	<VersionInfo Organization="SWDC RTSoft" Version="1.0" Author="AN">
	</VersionInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event">
				<With Var="QUEUE_ID"/>
				<With Var="IMG_ID"/>
				<With Var="POINTS"/>
				<With Var="COLOR"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event">
				<With Var="STATUS"/>
				<With Var="IMG_IDO"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QUEUE_ID" Type="STRING"/>
			<VarDeclaration Name="IMG_ID" Type="UDINT"/>
			<VarDeclaration Name="POINTS" Type="INT" ArraySize="1024"/>
			<VarDeclaration Name="COLOR" Type="INT" ArraySize="3"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="STATUS" Type="STRING"/>
			<VarDeclaration Name="IMG_IDO" Type="UDINT"/>
		</OutputVars>
	</InterfaceList>
	<SimpleFB><Algorithm Name="REQ"><ST>
	</ST></Algorithm></SimpleFB>
</FBType>

