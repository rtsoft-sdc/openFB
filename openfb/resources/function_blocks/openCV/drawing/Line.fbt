<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="Line" Comment="openCV line drawer" >
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event">
				<With Var="IMG_ID"/>
				<With Var="QUEUE_ID"/>
				<With Var="PT1"/>
				<With Var="PT2"/>
				<With Var="COLOR"/>
				<With Var="THICKNESS"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event">
				<With Var="IMG_IDO"/>
				<With Var="QUEUE_IDO"/>
				<With Var="STATUS"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL"/>
			<VarDeclaration Name="IMG_ID" Type="UDINT"/>
			<VarDeclaration Name="QUEUE_ID" Type="STRING"/>
			<VarDeclaration Name="PT1" Type="INT" ArraySize="2"/>
			<VarDeclaration Name="PT2" Type="INT" ArraySize="2"/>
			<VarDeclaration Name="COLOR" Type="INT" ArraySize="3"/>
			<VarDeclaration Name="THICKNESS" Type="INT"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="IMG_IDO" Type="UDINT"/>
			<VarDeclaration Name="QUEUE_IDO" Type="STRING"/>
			<VarDeclaration Name="STATUS" Type="STRING"/>
		</OutputVars>
	</InterfaceList>
</FBType>

