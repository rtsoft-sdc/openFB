<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="PUTTEXT" Comment="openCV text drawer" >
	<VersionInfo Organization="SWDC RTSoft" Version="1.0" Author="AN">
	</VersionInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event">
				<With Var="QUEUE_ID"/>
				<With Var="IMG_ID"/>
				<With Var="TEXT"/>
				<With Var="ORG"/>
				<With Var="FONT_FACE"/>
				<With Var="FONT_SCALE"/>
				<With Var="COLOR"/>
				<With Var="THICKNESS"/>
				<With Var="BOTTOMLEFTORIGIN"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event">
				<With Var="STATUS"/>
				<With Var="IMG_IDO"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QUEUE_ID" Type="STRING"/>
			<VarDeclaration Name="IMG_ID" Type="UDINT"/>
			<VarDeclaration Name="TEXT" Type="STRING"/>
			<VarDeclaration Name="ORG" Type="INT" ArraySize="2" Comment="Bottom-left corner of the text string in the image"/>
			<VarDeclaration Name="FONT_FACE" Type="INT"/>
			<VarDeclaration Name="FONT_SCALE" Type="REAL"/>
			<VarDeclaration Name="COLOR" Type="INT" ArraySize="3"/>
			<VarDeclaration Name="THICKNESS" Type="INT"/>
			<VarDeclaration Name="BOTTOMLEFTORIGIN" Type="BOOL" Comment="When true, the image data origin is at the bottom-left corner, otherwise at the top-left corner"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="STATUS" Type="STRING"/>
			<VarDeclaration Name="IMG_IDO" Type="UDINT"/>
		</OutputVars>
	</InterfaceList>
	<SimpleFB><Algorithm Name="REQ"><ST>
	</ST></Algorithm></SimpleFB>
</FBType>

