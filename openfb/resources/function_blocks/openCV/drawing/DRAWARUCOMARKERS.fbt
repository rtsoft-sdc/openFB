<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="DRAWARUCOMARKERS" Comment=" Draw Aruco Markers" >
	<VersionInfo Organization="SWDC RTSoft" Version="1.0" Author="AN">
	</VersionInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event">
				<With Var="QUEUE_ID"/>
				<With Var="IMG_ID"/>
				<With Var="CORNERS"/>
				<With Var="IDS"/>
				<With Var="DRAWCORNERS"/>
				<With Var="DRAWAXIS"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event">
				<With Var="STATUS"/>
				<With Var="IMG_IDO"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QUEUE_ID" Type="STRING"/>
			<VarDeclaration Name="IMG_ID" Type="UDINT"/>
			<VarDeclaration Name="CORNERS" Type="INT" ArraySize="1024"/>
			<VarDeclaration Name="IDS" Type="INT" ArraySize="1024"/>
			<VarDeclaration Name="DRAWCORNERS" Type="BOOL" Comment="Bool flag to Draw Corners"/>
			<VarDeclaration Name="DRAWAXIS" Type="BOOL" Comment="Bool flag to Draw Axis"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="STATUS" Type="STRING"/>
			<VarDeclaration Name="IMG_IDO" Type="UDINT"/>
		</OutputVars>
	</InterfaceList>
	<SimpleFB><Algorithm Name="REQ"><ST>
	</ST></Algorithm></SimpleFB>
</FBType>
