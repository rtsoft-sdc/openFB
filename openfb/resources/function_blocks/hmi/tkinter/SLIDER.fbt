<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="SLIDER" Comment="recognize bubble size" >
	<VersionInfo Organization="SWDC RTSoft" Version="1.0" Author="AN">
	</VersionInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="Event">
				<With Var="MINV"/>
				<With Var="MAXV"/>
			</Event>
		</EventInputs>
		<EventInputs>
			<Event Name="REQ" Type="Event">
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="Event">
			</Event>
			<Event Name="CNF" Type="Event">
				<With Var="VALUE"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="MINV" Type="UDINT"/>
			<VarDeclaration Name="MAXV" Type="UDINT"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="VALUE" Type="UDINT"/>
		</OutputVars>
	</InterfaceList>
</FBType>
