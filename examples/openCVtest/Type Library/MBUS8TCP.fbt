<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<FBType Name="MBUS8TCP" Comment="8-Channel Modbus TCP Client Interface Block">
  <Identification Standard="IEC 61499-1" />
  <VersionInfo Organization="RTSoft" Version="1.0" Author="an" Date="2026-07-10" />
  <InterfaceList>
    <EventInputs>
      <Event Name="MAP" Comment="Initialization Request">
        <With Variable="QI" />
        <With Variable="PARAMS" />
        <With Variable="QI" />
		<With Variable="IO0" />
        <With Variable="IO1" />
        <With Variable="IO2" />
        <With Variable="IO3" />
        <With Variable="IO4" />
        <With Variable="IO5" />
        <With Variable="IO6" />
        <With Variable="IO7" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="MAPO" Comment="Initialization Confirm">
        <With Variable="QO" />
      </Event>
      <Event Name="IND" Comment="Execution Confirm">
        <With Variable="QO" />
        <With Variable="STATUS" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="QI" Type="BOOL" Comment="Event Input Qualifier" />
      <VarDeclaration Name="PARAMS" Type="STRING" Comment="Initialization Parameters" />
      <VarDeclaration Name="IO0" Type="STRING" Comment="Input Output 0" />
      <VarDeclaration Name="IO1" Type="STRING" Comment="Input Output 1" />
      <VarDeclaration Name="IO2" Type="STRING" Comment="Input Output 2" />
      <VarDeclaration Name="IO3" Type="STRING" Comment="Input Output 3" />
      <VarDeclaration Name="IO4" Type="STRING" Comment="Input Output 4" />
      <VarDeclaration Name="IO5" Type="STRING" Comment="Input Output 5" />
      <VarDeclaration Name="IO6" Type="STRING" Comment="Input Output 6" />
      <VarDeclaration Name="IO7" Type="STRING" Comment="Input Output 7" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="QO" Type="BOOL" Comment="Event Output Qualifier" />
      <VarDeclaration Name="STATUS" Type="STRING" Comment="Service Status" />
    </OutputVars>
  </InterfaceList>
</FBType>